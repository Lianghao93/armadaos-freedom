From: MangoHud <noreply@localhost>
Subject: [PATCH] sm8850 battery and thermal sensors

diff --git a/src/battery.cpp b/src/battery.cpp
index 7104f9c..6471b65 100644
--- a/src/battery.cpp
+++ b/src/battery.cpp
@@ -7,16 +7,26 @@ using namespace std;
 
 void BatteryStats::numBattery() {
     int batteryCount = 0;
+    const int maxBatt = static_cast<int>(sizeof(battPath) / sizeof(battPath[0]));
+
     if (!fs::exists("/sys/class/power_supply/")) {
          batteryCount = 0;
     }
     
     else {
-        string battery = "/sys/class/power_supply/battery";
-        
-        if (fs::exists(battery)) {
-            battPath[batteryCount] = battery;
-            batteryCount += 1;
+        for (const auto& p : fs::directory_iterator("/sys/class/power_supply/")) {
+            if (batteryCount >= maxBatt)
+                break;
+
+            if (!p.is_directory())
+                continue;
+
+            std::ifstream typeFile((p.path() / "type").string());
+            string type;
+            if (std::getline(typeFile, type) && type == "Battery") {
+                battPath[batteryCount] = p.path().string();
+                batteryCount += 1;
+            }
         }
     }
 
