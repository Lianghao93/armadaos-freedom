diff --git a/src/late_base_paint.h b/src/late_base_paint.h
new file mode 100644
index 0000000..307f88a
--- /dev/null
+++ b/src/late_base_paint.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: BSD-2-Clause
+//
+// y700: one bounded "late base paint" opportunity.
+//
+// On the TB323FU fixed-refresh path the timer can wake ~30us after the
+// physical flip with no repaint pending. A non-FIFO base commit that is
+// already accepted but whose done event arrives ~365us later then only
+// sets hasRepaint; the Normal !vblank path skips it and waits a full
+// refresh instead. This records a single, bounded, identity-checked
+// opportunity to spend a skipped fixed-refresh paint slot on that base
+// frame, default off.
+//
+// Header-only and dependency-free on purpose so it can be unit tested in
+// isolation, with no gamescope types leaking in.
+
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+
+struct LateBasePaintOpportunity
+{
+	// Deadline (nanoseconds) of the vblank this opportunity belongs to.
+	// Zero means inactive; only this member is the active flag.
+	uint64_t target = 0;
+	uint64_t idx = 0;
+	uint64_t focusSeq = 0;
+	uint64_t baseCommitID = 0;
+	uint64_t connectorID = 0;
+	uint64_t refresh = 0;
+	uint64_t cap = 0;
+
+	void Clear()
+	{
+		target = 0;
+	}
+
+	// Active and every identity field equal.
+	bool Matches( uint64_t ulTarget, uint64_t ulSeq, uint64_t ulConnector, uint64_t ulRefresh, uint64_t ulCap ) const
+	{
+		return target != 0 &&
+			target == ulTarget &&
+			focusSeq == ulSeq &&
+			connectorID == ulConnector &&
+			refresh == ulRefresh &&
+			cap == ulCap;
+	}
+
+	// Consume at most once. Rejects once the deadline passed, once the
+	// remaining time fits entirely in the budget (no room left), and when
+	// the caller is still looking at the same held base commit.
+	bool ConsumeIfReady( uint64_t ulNow, uint64_t ulBudget, uint64_t ulNewCommitID )
+	{
+		if ( target == 0 )
+			return false;
+		if ( ulNow >= target )
+			return false;
+		if ( ulBudget >= target - ulNow )
+			return false;
+		if ( ulNewCommitID == baseCommitID )
+			return false;
+
+		Clear();
+		return true;
+	}
+};
+
+}
