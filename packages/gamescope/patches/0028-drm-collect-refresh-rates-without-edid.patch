@@ -65,6 +65,35 @@ TEST_CASE("Known-display matching receives connector identity", "[display]")
     external.model = "Some Panel";
     CHECK_FALSE( script.Manager().Gamescope().Config.LookupDisplay( script, external ) );
 
+    // An identity with no EDID information at all (empty vendor/model/dataString,
+    // product 0) must still match the identity-based profile.
+    const GamescopeDisplayLookupInfo noEdidInfo
+    {
+        .vendor = "",
+        .product = 0,
+        .model = "",
+        .dataString = "",
+        .connector = "DSI-1",
+        .deviceId = "test-device",
+        .internal = true,
+        .hasEdid = false,
+    };
+    auto noEdidMatch = script.Manager().Gamescope().Config.LookupDisplay( script, noEdidInfo );
+    REQUIRE( noEdidMatch.has_value() );
+    CHECK( noEdidMatch->first == "test_edidless_panel" );
+
+    GamescopeDisplayLookupInfo noEdidWrongDevice = noEdidInfo;
+    noEdidWrongDevice.deviceId = "other-device";
+    CHECK_FALSE( script.Manager().Gamescope().Config.LookupDisplay( script, noEdidWrongDevice ) );
+
+    GamescopeDisplayLookupInfo noEdidExternal = noEdidInfo;
+    noEdidExternal.internal = false;
+    CHECK_FALSE( script.Manager().Gamescope().Config.LookupDisplay( script, noEdidExternal ) );
+
+    GamescopeDisplayLookupInfo noEdidWrongConnector = noEdidInfo;
+    noEdidWrongConnector.connector = "HDMI-A-1";
+    CHECK_FALSE( script.Manager().Gamescope().Config.LookupDisplay( script, noEdidWrongConnector ) );
