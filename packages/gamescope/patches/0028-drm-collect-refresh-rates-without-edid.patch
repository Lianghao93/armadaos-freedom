diff --git a/tests/test_mode_list.cpp b/tests/test_mode_list.cpp
index 4a7f0ba..5281000 100644
--- a/tests/test_mode_list.cpp
+++ b/tests/test_mode_list.cpp
@@ -1,7 +1,11 @@
 #include <catch2/catch_test_macros.hpp>
 
+#include "edid.h"
 #include "mode_list_file.h"
 
+#include <cstdint>
+#include <vector>
+
 using namespace gamescope;
 
 TEST_CASE("Mode list round-trip", "[mode_list]") {
@@ -54,3 +58,65 @@ TEST_CASE("Mode list parse rejects out-of-range values", "[mode_list]") {
 	REQUIRE( parsed[0].uHeight == 1080 );
 	REQUIRE( parsed[0].uRefresh == 60 );
 }
+
+TEST_CASE("Collect refresh rates dedupes and sorts same-size modes", "[mode_list]") {
+	// Real Y700 1904x3040 connector rates, deliberately unsorted with a
+	// duplicate, plus entries that must be ignored (other size / zero rate).
+	std::vector<BackendMode> modes = {
+		{ 1904, 3040, 120 },
+		{ 1904, 3040, 164 },
+		{ 1904, 3040, 90 },
+		{ 1904, 3040, 60 },
+		{ 1904, 3040, 30 },
+		{ 1904, 3040, 120 },
+		{ 1920, 1080, 144 },
+		{ 1280, 720, 0 },
+		{ 1904, 3040, 0 },
+	};
+
+	std::vector<uint32_t> rates = CollectModeRefreshRates( modes, 1904, 3040 );
+	REQUIRE( rates == std::vector<uint32_t>{ 30, 60, 90, 120, 164 } );
+}
+
+TEST_CASE("Collect refresh rates handles empty and zero-size inputs", "[mode_list]") {
+	REQUIRE( CollectModeRefreshRates( {}, 1904, 3040 ).empty() );
+
+	std::vector<BackendMode> modes = { { 1904, 3040, 120 }, { 1904, 3040, 60 } };
+	REQUIRE( CollectModeRefreshRates( modes, 0, 3040 ).empty() );
+	REQUIRE( CollectModeRefreshRates( modes, 1904, 0 ).empty() );
+	REQUIRE( CollectModeRefreshRates( modes, 1920, 1080 ).empty() );
+}
+
+TEST_CASE("Y700 120Hz timing cannot be encoded but real rates are collected", "[mode_list][edid]") {
+	// Real Y700 120Hz timing (pixel clock 915552kHz). Its clock exceeds what a
+	// synthetic DTD can encode, so GenerateSimpleEdid must refuse it rather
+	// than emit a fake mode, while the real connector modes still provide the
+	// full refresh rate list.
+	EdidModeInfo mode
+	{
+		.clockKHz = 915552,
+		.hdisplay = 1904,
+		.hsyncStart = 2084,
+		.hsyncEnd = 2116,
+		.htotal = 2244,
+		.vdisplay = 3040,
+		.vsyncStart = 3066,
+		.vsyncEnd = 3070,
+		.vtotal = 3400,
+		.physicalWidthMm = 168,
+		.physicalHeightMm = 268,
+		.hsyncPositive = true,
+		.vsyncPositive = true,
+	};
+
+	REQUIRE( GenerateSimpleEdid( mode ).empty() );
+
+	std::vector<BackendMode> modes = {
+		{ 1904, 3040, 30 },
+		{ 1904, 3040, 60 },
+		{ 1904, 3040, 90 },
+		{ 1904, 3040, 120 },
+		{ 1904, 3040, 164 },
+	};
+	REQUIRE( CollectModeRefreshRates( modes, 1904, 3040 ) == std::vector<uint32_t>{ 30, 60, 90, 120, 164 } );
+}
