diff --git a/src/mode_list_file.h b/src/mode_list_file.h
index 87bcbee..07280d9 100644
--- a/src/mode_list_file.h
+++ b/src/mode_list_file.h
@@ -2,6 +2,7 @@
 
 #include "gamescope_shared.h"
 
+#include <algorithm>
 #include <cstdio>
 #include <span>
 #include <string>
@@ -50,6 +51,30 @@ namespace gamescope
         return modes;
     }
 
+    // Collect the distinct refresh rates the connector reports for one size,
+    // in ascending order. Used to keep the kernel mode list usable when there
+    // is no display-specific dynamic refresh rate profile.
+    inline std::vector<uint32_t> CollectModeRefreshRates( std::span<const BackendMode> modes, uint32_t width, uint32_t height )
+    {
+        std::vector<uint32_t> rates;
+
+        if ( !width || !height || modes.empty() )
+            return rates;
+
+        for ( const BackendMode &mode : modes )
+        {
+            if ( mode.uWidth != width || mode.uHeight != height || !mode.uRefresh )
+                continue;
+
+            rates.push_back( mode.uRefresh );
+        }
+
+        std::sort( rates.begin(), rates.end() );
+        rates.erase( std::unique( rates.begin(), rates.end() ), rates.end() );
+
+        return rates;
+    }
+
     void WriteModeListFile( std::span<const BackendMode> modes );
     std::vector<BackendMode> LoadModeListFile();
 }
