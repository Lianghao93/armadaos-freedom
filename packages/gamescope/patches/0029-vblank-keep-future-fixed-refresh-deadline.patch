diff --git a/src/vblank_schedule.h b/src/vblank_schedule.h
new file mode 100644
index 0000000..eae8f3a
--- /dev/null
+++ b/src/vblank_schedule.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+    struct VBlankScheduleTime
+    {
+        // The expected time for the vblank we want to target.
+        uint64_t ulTargetVBlank = 0;
+        // The vblank offset by the redzone/scheduling calculation.
+        // This is when we want to wake-up by to meet that vblank time above.
+        uint64_t ulScheduledWakeupPoint = 0;
+    };
+
+    // Pure, fixed-refresh vblank schedule calculation.
+    //
+    // The caller must supply a positive interval. This does not attempt to
+    // defend against a zero/hypothetical interval; that is a caller contract.
+    //
+    // The physical vblank targets lie on a fixed phase grid anchored at
+    // ulLastVBlank, spaced by ulInterval. We always return the first grid point
+    // strictly in the future, rolled forward in O(1) even when the anchor is
+    // far in the past (eg. a headless session that never marks a vblank).
+    //
+    // If ulMinimumTarget is non-zero we must not schedule a target earlier than
+    // it (eg. a deadline we already committed to). We advance along the same
+    // phase grid by whole intervals (ceil) rather than snapping to an arbitrary
+    // floor, so we never drift off the physical vblank phase.
+    //
+    // The scheduled wakeup point is ulOffset before the target, clamped to be no
+    // earlier than ulNow. The target is independent of that clamping.
+    inline VBlankScheduleTime CalculateFixedVBlankSchedule( uint64_t ulLastVBlank, uint64_t ulNow, uint64_t ulInterval, uint64_t ulOffset, uint64_t ulMinimumTarget = 0 )
+    {
+        // First physical vblank target on our phase grid.
+        uint64_t ulTarget = ulLastVBlank + ulInterval;
+
+        // If we have already passed it, step forward in whole intervals in one
+        // shot. ( ulNow - ulTarget ) / ulInterval + 1 lands on the first grid
+        // point strictly after ulNow, including when ulTarget == ulNow.
+        if ( ulTarget <= ulNow )
+            ulTarget += ( ( ulNow - ulTarget ) / ulInterval + 1 ) * ulInterval;
+
+        // Respect a minimum target we must not walk back past, while keeping
+        // the result on the same phase grid (round up to the next grid point).
+        if ( ulTarget < ulMinimumTarget )
+        {
+            const uint64_t ulDelta = ulMinimumTarget - ulTarget;
+            ulTarget += ( ( ulDelta + ulInterval - 1 ) / ulInterval ) * ulInterval;
+        }
+
+        // Wake up ulOffset before the target, protecting the subtraction from
+        // underflowing when ulOffset >= ulTarget.
+        uint64_t ulScheduledWakeupPoint = ulTarget >= ulOffset ? ulTarget - ulOffset : 0;
+        if ( ulScheduledWakeupPoint < ulNow )
+            ulScheduledWakeupPoint = ulNow;
+
+        VBlankScheduleTime schedule =
+        {
+            .ulTargetVBlank = ulTarget,
+            .ulScheduledWakeupPoint = ulScheduledWakeupPoint,
+        };
+        return schedule;
+    }
+}
