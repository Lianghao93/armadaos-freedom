+		// Fixed-refresh + timerfd path: compute the schedule directly against
+		// the physical vblank phase grid instead of going through
+		// GetNextVBlank, which clamps to a single interval and can skip a
+		// still-future physical target.
+		//
+		// Nothing here runs for VRR or the nudge-thread path; those keep their
+		// existing behaviour below.
+		if ( !bVRR && UsingTimerFD() )
+		{
+			const uint64_t ulNow = get_time_in_nanos();
+
+			// When pre-emptively re-arming we must not schedule an earlier
+			// target than the one we already committed to. ArmNextVBlank holds
+			// m_ScheduleMutex while calling us, so reading the prior timerfd
+			// schedule here is safe.
+			const uint64_t ulMinimumTarget = bPreemptive
+				? m_TimerFDSchedule.ulTargetVBlank + ulRefreshInterval
+				: 0;
+
+			return CalculateFixedVBlankSchedule( GetLastVBlank(), ulNow, ulRefreshInterval, ulOffset, ulMinimumTarget );
+		}
+
