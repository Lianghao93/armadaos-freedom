+    // SDR transparent-overlay fast path: when the base is a plain SDR layer at
+    // full opacity and every overlay is a fully-transparent premult/coverage
+    // sample, the composited result is exactly the base. We can then skip the
+    // final srgbToLinear (colorspace_blend_tf) the color-mgmt path would apply,
+    // and store the still gamma-encoded base directly instead of doing an
+    // inverse-then-reencode round trip on pixels that never actually blended.
+    bool sdrFastPathEligible =
+        c_transparent_fast_path &&
+        c_layerCount > 0 &&
+        c_output_eotf == EOTF_Gamma22 &&
+        !c_itm_enable &&
+        c_compositing_debug == 0 &&
+        u_opacity[0] == 1.0 &&
+        (get_layer_colorspace(0) == colorspace_linear || get_layer_colorspace(0) == colorspace_sRGB) &&
+        textureQueryLevels(s_shaperLut[EOTF_Gamma22]) != 0;
+
+    bool overlaysCached = false;
+    vec4 overlayColors[VKR_SAMPLER_SLOTS];
+
