From fd63880240ce7b119336be67fb496fea148350df Mon Sep 17 00:00:00 2001
From: Victor Fuentes <victor@vlinkz.dev>
Date: Wed, 29 Jul 2026 19:26:08 -0700
Subject: [PATCH 218/221] drm/msm/dp: handle PHY and link status errors

Rebased onto the current single-argument msm_dp_ctrl API (#9): the
controller keeps the panel in its private data, so no call-site or
prototype refactor is involved here. Only the missing return value
checks are restored.

msm_dp_ctrl_enable_mainlink_clocks() ignored a failed phy_power_on()
and went on to set the OPP rate and enable the link clocks on a PHY
that is not powered. Propagate the error instead.

msm_dp_ctrl_channel_eq_ok() ignored a failed link status read and
passed uninitialized stack data to drm_dp_channel_eq_ok(). Treat the
read failure as a failed channel equalization.

Signed-off-by: Victor Fuentes <victor@vlinkz.dev>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 9 +++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1801,7 +1801,11 @@ static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl)
 	ctrl->phy_opts.dp.ssc = drm_dp_max_downspread(dpcd);
 
 	phy_configure(phy, &ctrl->phy_opts);
-	phy_power_on(phy);
+	ret = phy_power_on(phy);
+	if (ret) {
+		DRM_ERROR("DP PHY power on failed. ret=%d\n", ret);
+		return ret;
+	}
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
@@ -2258,7 +2262,10 @@ static bool msm_dp_ctrl_channel_eq_ok(struct msm_dp_ctrl_private *ctrl)
 	u8 link_status[DP_LINK_STATUS_SIZE];
 	int num_lanes = ctrl->link->link_params.num_lanes;
+	int ret;
 
-	drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+	ret = drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+	if (ret)
+		return false;
 
 	return drm_dp_channel_eq_ok(link_status, num_lanes);
 }
