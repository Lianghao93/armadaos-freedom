From 214e7f535ba8db243df2823243fc89b4251bc1eb Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sun, 27 Sep 2026 11:59:56 +0000
Subject: [PATCH 220/221] drm/msm/dp: baldr: balance plugged runtime PM

The plug handler takes a runtime PM reference every time it runs and
sets dp->plugged; the unplug handler drops a single reference when
dp->plugged is set. But the plug handler runs more than once per plug:
the Type-C side repeats "connected" notifications every few seconds,
and msm_dp_bridge_detect() also marks the sink plugged and keeps the
reference it took, again on every detect while the sink stays
connected. Every extra reference is leaked on unplug.

On a Lenovo TB323FU (SM8850, DP over the USB-C port via pmic_glink
altmode) the DP controller's usage count reached 28-34 after a few
plugs, so the controller never runtime-suspended after the TV was
unplugged, which kept the MDSS core GDSC on with all displays off.

Rebased onto the current tree (#9), where the panel lives in the
controller private data. The new one-reference-per-plugged-state policy
is applied only on the machine it was validated on,
of_machine_is_compatible("lenovo,baldur"). All other machines keep the
existing calls and behaviour byte for byte: the plug handler still
takes a reference on every notification and detect() still releases
only the reference it took when it finds the sink gone.

On Baldur the plug handler takes the reference only when the sink was
not plugged yet, and detect() releases its own reference when the
plugged state already holds one, or releases both when the sink is
gone. The existing runtime PM error rollback in the plug handler is
preserved.

With this the count stays at 1-3 while a TV is connected, the
controller suspends 3-4 s after unplug, MDSS suspends and its GDSC
powers off on DPMS off, and replug (after 20 s and quick) still brings
the picture back.

Assisted-by: LLM [Claude Code]
Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 21 ++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -9,5 +9,6 @@
 #include <linux/debugfs.h>
 #include <linux/component.h>
+#include <linux/of.h>
 #include <linux/of_irq.h>
 #include <linux/phy/phy.h>
 #include <linux/delay.h>
@@ -407,9 +408,17 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 	guard(mutex)(&dp->plugged_lock);
 
-	ret = pm_runtime_resume_and_get(&pdev->dev);
-	if (ret) {
-		DRM_ERROR("failed to pm_runtime_resume\n");
-		return ret;
+	/*
+	 * The plugged state holds one runtime PM reference, dropped by the
+	 * unplug handler. The Type-C side repeats "connected" notifications,
+	 * and detect() may have seen the sink first: take it only once.
+	 * Other machines keep the original per-notification reference.
+	 */
+	if (!dp->plugged || !of_machine_is_compatible("lenovo,baldur")) {
+		ret = pm_runtime_resume_and_get(&pdev->dev);
+		if (ret) {
+			DRM_ERROR("failed to pm_runtime_resume\n");
+			return ret;
+		}
 	}
 
 	msm_dp_aux_enable_xfers(dp->aux, true);
@@ -844,6 +852,7 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
 	struct drm_dp_desc desc;
 	bool phy_deinit;
+	bool was_plugged;
 	int ret;
 
 	dp = to_dp_bridge(bridge)->msm_dp_display;
@@ -857,6 +866,7 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
 		return status;
 	}
 
+	was_plugged = priv->plugged;
 	phy_deinit = msm_dp_display_host_phy_init(priv);
 
 	msm_dp_aux_enable_xfers(priv->aux, true);
@@ -907,6 +917,12 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
 		}
 
 		pm_runtime_put_sync(&dp->pdev->dev);
+		/* the sink is gone: drop the plugged state's reference too */
+		if (was_plugged && of_machine_is_compatible("lenovo,baldur"))
+			pm_runtime_put_sync(&dp->pdev->dev);
+	} else if (was_plugged && of_machine_is_compatible("lenovo,baldur")) {
+		/* the plugged state already holds its reference */
+		pm_runtime_put_sync(&dp->pdev->dev);
 	}
 
 	return status;
