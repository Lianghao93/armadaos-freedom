From bec6350ce7dbb124c2e1036a26f448b6daf3174f Mon Sep 17 00:00:00 2001
From: Joonhoe Kim <26rote@gmail.com>
Date: Sat, 26 Sep 2026 05:06:31 +0000
Subject: [PATCH 221/221] drm/msm/dp: baldr: retrain after quick replug

Unplugging an external display and plugging the same one back within a
couple of seconds can beat userspace to the unplug: mutter still has the
CRTC enabled when the connector reads "connected" again with the same
EDID, so it changes nothing, no atomic_enable follows, and the link that
died with the unplug is never trained again. The sink shows "no signal"
until the output is toggled by hand.

Note an unplug that happens while the stream is on and, on the next plug,
retrain the link once with the existing link maintenance sequence (the
one IRQ_HPD link-status requests use). Only once: the Type-C altmode side
repeats "connected" notifications every few seconds and each retrain
blanks the sink.

This depends on the preceding runtime PM balancing patch. It is applied
only on the machine it was validated on,
of_machine_is_compatible("lenovo,baldur"): link_lost is set only there,
and the unplug path keeps its existing locks and state.

Rebased onto the current tree (#9): msm_dp_ctrl_link_maintenance() takes
only the controller (the panel is in the controller private data), so
the public wrapper added here takes a single ctrl argument and calls the
existing helper. No two-argument 7.3 style API is reintroduced.

Seen on the Lenovo TB323FU (kaanapali) with an LG TV through a USB-C to
HDMI cable: replug within ~2 s gave "no signal"; with this the picture
comes back (retrain rc=0, once).

Signed-off-by: Joonhoe Kim <26rote@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c    |  8 ++++++++
 drivers/gpu/drm/msm/dp/dp_ctrl.h    |  1 +
 drivers/gpu/drm/msm/dp/dp_display.c | 17 +++++++++++++++++
 3 files changed, 26 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2015,6 +2015,14 @@ static int msm_dp_ctrl_link_maintenance(struct msm_dp_ctrl_private *ctrl)
 	return ret;
 }
 
+int msm_dp_ctrl_retrain_link(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	struct msm_dp_ctrl_private *ctrl =
+		container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
+
+	return msm_dp_ctrl_link_maintenance(ctrl);
+}
+
 #define SCRAMBLER_RESET_COUNT_VALUE		0xFC
 
 static void msm_dp_ctrl_send_phy_pattern(struct msm_dp_ctrl_private *ctrl,
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.h b/drivers/gpu/drm/msm/dp/dp_ctrl.h
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.h
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.h
@@ -24,5 +24,6 @@
 irqreturn_t msm_dp_ctrl_isr(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_handle_sink_request(struct msm_dp_ctrl *msm_dp_ctrl);
+int msm_dp_ctrl_retrain_link(struct msm_dp_ctrl *msm_dp_ctrl);
 struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev,
 				    struct msm_dp_link *link,
 				    struct msm_dp_panel *panel,
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -56,6 +56,8 @@ struct msm_dp_display_private {
 
 	struct mutex plugged_lock;
 	bool plugged;
+	/* unplugged while the stream was on: retrain on the next plug */
+	bool link_lost;
 
 	struct drm_device *drm_dev;
 
@@ -418,6 +420,17 @@ static int msm_dp_hpd_plug_handle(struct msm_dp_display_private *dp)
 
 	ret = msm_dp_display_process_hpd_high(dp);
 
+	/*
+	 * A quick replug can come back with the CRTC still enabled and no
+	 * atomic_enable to follow: retrain here, once per unplug.
+	 */
+	if (!ret && dp->link_lost && dp->msm_dp_display.power_on) {
+		int rc = msm_dp_ctrl_retrain_link(dp->ctrl);
+
+		drm_dbg_dp(dp->drm_dev, "replug while streaming: retrain rc=%d\n", rc);
+	}
+	dp->link_lost = false;
+
 	drm_dbg_dp(dp->drm_dev, "After, type=%d sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
@@ -456,6 +469,10 @@ static int msm_dp_hpd_unplug_handle(struct msm_dp_display_private *dp)
 	if (!dp->plugged)
 		return 0;
 
+	if (of_machine_is_compatible("lenovo,baldur") &&
+	    dp->msm_dp_display.power_on)
+		dp->link_lost = true;
+
 	/* Don't forget modes for eDP */
 	if (!dp->msm_dp_display.is_edp)
 		msm_dp_panel_unplugged(dp->panel, dp->msm_dp_display.connector);
-- 
