+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -148,6 +148,18 @@
 			 */
 			timing->width =
 				DIV_ROUND_UP(timing->dce_bytes_per_line * 8,
+					     dsc->bits_per_component * 3);
+		} else if (of_machine_is_compatible("lenovo,baldur") &&
+			   dsc->dsc_version_minor == 2 &&
+			   dsc->bits_per_component > 8) {
+			/*
+			 * Baldur's compressed line is carried in whole bytes; round up
+			 * exactly as the DSI host does so both blocks agree on the
+			 * active pixel-clock width (952 * 8 / 30 -> 254, not 253).
+			 */
+			timing->width =
+				DIV_ROUND_UP(timing->width *
+					     drm_dsc_get_bpp_int(dsc),
 					     dsc->bits_per_component * 3);
 		} else {
 			/*
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dsc_1_2.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dsc_1_2.c
