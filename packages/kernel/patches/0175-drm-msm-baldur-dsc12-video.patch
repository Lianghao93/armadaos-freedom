+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dsc_1_2.c
@@ -125,11 +125,12 @@
 		data |= BIT(9);
 
 	/*
-	 * SM8750 DPU 12.x hardened DSC needs full ICH error precision for
-	 * 10/12-bpc streams. Enable it only for the Elden panel so other
-	 * DPU_DSC_FULL_ICH_PREC capable configurations are unaffected.
+	 * The hardened DSC blocks need full ICH error precision for
+	 * 10/12-bpc streams. Enable it only for the Elden and Baldur
+	 * panels; other DPU_DSC_FULL_ICH_PREC configurations are unaffected.
 	 */
-	if (of_machine_is_compatible("lenovo,elden") &&
+	if ((of_machine_is_compatible("lenovo,elden") ||
+	     of_machine_is_compatible("lenovo,baldur")) &&
 	    test_bit(DPU_DSC_FULL_ICH_PREC, &hw_dsc->caps->features) &&
 	    dsc->dsc_version_minor == 0x2 &&
 	    dsc->bits_per_component > 8)
