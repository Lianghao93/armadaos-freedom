Subject: [PATCH] clk: qcom: baldur: gdsc: hold the clock controller while a GDSC is on

Provenance: this project's Lenovo TB323FU tree, patches 0046 and 0103

A GDSC whose parents are the controller's own power domains (pd_list,
e.g. camcc: MMCX + MXC) needs those rails at the required-opps level to
switch on, but the controller only holds that vote while it is runtime
active. Powering the GDSC before any of its clocks is prepared left MXC
at level 0 and the GDSC stuck off. Keep the clock controller runtime
active while such a GDSC is on.

genpd also powers domains on in the noirq phase of system resume, where
runtime PM is disabled: pm_runtime_resume_and_get() fails with -EACCES
and gdsc_enable() returns the error, but genpd ignores it and marks the
domain on. When genpd powers it off again, gdsc_disable() must not drop
a reference that was never taken. Remember whether this GDSC holds the
reference and drop it only then.

Only Lenovo baldur registers rpm_dev; every other machine keeps NULL and
behaves exactly as before.  The registration-time get_noresume() for a
GDSC that is already on is the original 0103 boot-on accounting.
Register a devm action that drops that reference (only while it is held)
so a later probe failure or the device's removal cannot leak it; normal
disable still drops its own reference exactly once.

---
 2 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/drivers/clk/qcom/gdsc.c b/drivers/clk/qcom/gdsc.c
index 499e5a348c07..95936c61beb2 100644
--- a/drivers/clk/qcom/gdsc.c
+++ b/drivers/clk/qcom/gdsc.c
@@ -11,7 +11,9 @@
 #include <linux/jiffies.h>
 #include <linux/kernel.h>
 #include <linux/ktime.h>
+#include <linux/of.h>
 #include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
 #include <linux/reset-controller.h>
@@ -294,9 +296,8 @@
 	regmap_update_bits(sc->regmap, sc->gdscr, mask, mask);
 }
 
-static int gdsc_enable(struct generic_pm_domain *domain)
-{
-	struct gdsc *sc = domain_to_gdsc(domain);
+static int gdsc_enable_hw(struct gdsc *sc)
+{
 	int ret;
 
 	if (sc->pwrsts == PWRSTS_ON)
@@ -352,9 +353,8 @@
 	return 0;
 }
 
-static int gdsc_disable(struct generic_pm_domain *domain)
-{
-	struct gdsc *sc = domain_to_gdsc(domain);
+static int gdsc_disable_hw(struct gdsc *sc, struct generic_pm_domain *domain)
+{
 	int ret;
 
 	if (sc->pwrsts == PWRSTS_ON)
@@ -406,6 +406,60 @@
 		gdsc_assert_clamp_io(sc);
 
 	return 0;
+}
+
+/*
+	 * Our own cleanup: the boot-on get_noresume() in gdsc_register()
+	 * must not outlive a failed probe or the device's removal.
+	 */
+static void gdsc_rpm_release(void *data)
+{
+	struct gdsc *sc = data;
+
+	if (sc->rpm_held)
+		pm_runtime_put(sc->rpm_dev);
+	sc->rpm_held = false;
+	sc->rpm_dev = NULL;
+}
+
+/*
+	 * A GDSC under the controller's pd_list needs the controller's
+	 * required-opps vote while it switches on, so hold the controller
+	 * runtime active while the GDSC is on.
+	 */
+static int gdsc_enable(struct generic_pm_domain *domain)
+{
+	struct gdsc *sc = domain_to_gdsc(domain);
+	int ret;
+
+	if (sc->rpm_dev && !sc->rpm_held) {
+		ret = pm_runtime_resume_and_get(sc->rpm_dev);
+		if (ret < 0)
+			return ret;
+		sc->rpm_held = true;
+	}
+
+	ret = gdsc_enable_hw(sc);
+	if (ret && sc->rpm_held) {
+		pm_runtime_put(sc->rpm_dev);
+		sc->rpm_held = false;
+	}
+
+	return ret;
+}
+
+static int gdsc_disable(struct generic_pm_domain *domain)
+{
+	struct gdsc *sc = domain_to_gdsc(domain);
+	int ret;
+
+	ret = gdsc_disable_hw(sc, domain);
+	if (!ret && sc->rpm_held) {
+		pm_runtime_put(sc->rpm_dev);
+		sc->rpm_held = false;
+	}
+
+	return ret;
 }
 
 static int gdsc_set_hwmode(struct generic_pm_domain *domain, struct device *dev, bool mode)
@@ -668,6 +722,18 @@
 		ret = gdsc_init(scs[i]);
 		if (ret)
 			return ret;
+		if (of_machine_is_compatible("lenovo,baldur") && desc->pd_list &&
+		    scs[i]->pwrsts != PWRSTS_ON && pm_runtime_enabled(dev)) {
+			scs[i]->rpm_dev = dev;
+			/* already on: its disable will drop this */
+			if (gdsc_check_status(scs[i], GDSC_ON) > 0) {
+				pm_runtime_get_noresume(dev);
+				scs[i]->rpm_held = true;
+			}
+			ret = devm_add_action_or_reset(dev, gdsc_rpm_release, scs[i]);
+			if (ret)
+				return ret;
+		}
 		data->domains[i] = &scs[i]->pd;
 	}
 
diff --git a/drivers/clk/qcom/gdsc.h b/drivers/clk/qcom/gdsc.h
index 6e7f0a65fbce..e2e02305bcaf 100644
--- a/drivers/clk/qcom/gdsc.h
+++ b/drivers/clk/qcom/gdsc.h
@@ -78,6 +78,10 @@
 	const char 			*supply;
 	struct regulator		*rsupply;
 
+	/* the clock controller, held active while the GDSC is on (pd_list) */
+	struct device			*rpm_dev;
+	bool				rpm_held;
+
 	bool				needs_icc;
 	unsigned int			icc_path_index;
 	struct icc_path			*icc_path;
