+/*
+ * Modes that differ only in the vertical front porch: a DSI video-mode
+ * pipeline switches between them in place, without an encoder/panel off-on.
+ */
+static bool dpu_crtc_vfp_only(const struct drm_display_mode *a,
+			      const struct drm_display_mode *b)
+{
+	return a->clock == b->clock &&
+	       a->hdisplay == b->hdisplay && a->hsync_start == b->hsync_start &&
+	       a->hsync_end == b->hsync_end && a->htotal == b->htotal &&
+	       a->hskew == b->hskew && a->vdisplay == b->vdisplay &&
+	       a->vscan == b->vscan && a->flags == b->flags &&
+	       a->vsync_end - a->vsync_start == b->vsync_end - b->vsync_start &&
+	       a->vtotal - a->vsync_end == b->vtotal - b->vsync_end &&
+	       a->vtotal != b->vtotal;
+}
+
+static bool dpu_crtc_can_update_vfp(struct drm_crtc *crtc,
+				    struct drm_atomic_commit *state,
+				    struct drm_crtc_state *new)
+{
+	struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+	struct drm_encoder *enc;
+
+	if (!of_machine_is_compatible("lenovo,baldur"))
+		return false;
+
+	if (!new->mode_changed || new->active_changed ||
+	    new->connectors_changed || new->color_mgmt_changed ||
+	    !old->active || !new->active ||
+	    new->encoder_mask != old->encoder_mask || !new->encoder_mask)
+		return false;
+	if (!dpu_crtc_vfp_only(&old->adjusted_mode, &new->adjusted_mode))
+		return false;
+	drm_for_each_encoder_mask(enc, crtc->dev, new->encoder_mask) {
+		if (enc->encoder_type != DRM_MODE_ENCODER_DSI ||
+		    dpu_encoder_get_intf_mode(enc) != INTF_MODE_VIDEO)
+			return false;
+	}
+	return true;
+}
+
 static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		struct drm_atomic_commit *state)
 {
@@ -1713,6 +1756,12 @@
 	int rc = 0;
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
+
