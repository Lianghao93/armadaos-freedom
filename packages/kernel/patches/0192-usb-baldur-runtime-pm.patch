+static bool eusb2_wakeup = true;
+module_param(eusb2_wakeup, bool, 0644);
+
+static void dwc3_qcom_enable_wakeup_irq(struct dwc3_qcom *qcom, int irq,
+					unsigned int polarity)
 {
 	if (!irq)
 		return;
@@ -257,6 +263,10 @@
 	if (polarity)
 		irq_set_irq_type(irq, polarity);
 
+	/* drop an edge latched while the line was disabled */
+	if (qcom->has_eusb2_phy)
+		irq_set_irqchip_state(irq, IRQCHIP_STATE_PENDING, false);
+
 	enable_irq(irq);
 	enable_irq_wake(irq);
 }
@@ -270,15 +280,20 @@
 	disable_irq_nosync(irq);
 }
 
