 static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
@@ -439,6 +470,10 @@
 {
 	int ret;
 
+	/* a lazily disabled line would replay edges seen while "off" */
+	if (qcom->has_eusb2_phy)
+		irq_set_status_flags(irq, IRQ_DISABLE_UNLAZY);
+
 	/* Keep wakeup interrupts disabled until suspend */
 	ret = devm_request_threaded_irq(qcom->dev, irq, NULL,
 					qcom_dwc3_resume_irq,
@@ -611,6 +646,7 @@
 		return -ENOMEM;
 
 	qcom->dev = &pdev->dev;
+	qcom->has_eusb2_phy = of_machine_is_compatible("lenovo,baldur");
 
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
diff --git a/drivers/usb/gadget/function/f_ncm.c b/drivers/usb/gadget/function/f_ncm.c
--- a/drivers/usb/gadget/function/f_ncm.c
+++ b/drivers/usb/gadget/function/f_ncm.c
@@ -1158,7 +1158,16 @@
 		 *
 		 * This will call directly into u_ether's eth_start_xmit()
 		 */
-		netdev->netdev_ops->ndo_start_xmit(NULL, netdev);
+		if (netdev->netdev_ops->ndo_start_xmit(NULL, netdev) ==
+		    NETDEV_TX_BUSY) {
+			/*
+			 * No free request to send the pending NTB: try again
+			 * later, or it waits for the next datagram, which may
+			 * never come (the link stalls).
+			 */
+			hrtimer_forward_now(data, TX_TIMEOUT_NSECS);
+			return HRTIMER_RESTART;
+		}
 	}
 	return HRTIMER_NORESTART;
 }
