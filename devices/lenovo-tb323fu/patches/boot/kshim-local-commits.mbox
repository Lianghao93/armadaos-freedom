diff --git a/src/dt/handoff.c b/src/dt/handoff.c
new file mode 100644
index 0000000..307b07a
--- /dev/null
+++ b/src/dt/handoff.c
@@ -0,0 +1,202 @@
+#include "dt_handoff.h"
+#include "dt.h"
+#include <string.h>
+#include <stdint.h>
+#include <limits.h>
+int dt_handoff_reservations(const void *runtime, void *output); /* internal helper */
+
+#define HANDOFF_MAX_BANKS 64
+#define HANDOFF_MAX_CAP   (2u * 1024u * 1024u)
+
+static int dt_ovl(uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	return (a < d) && (c < b);
+}
+
+int dt_handoff_memory(const void *runtime, size_t runtime_size,
+		      const void *payload, size_t payload_size,
+		      void *output, size_t capacity)
+{
+	int rc, root, node, child;
+	uint32_t sac, ssc, tac, tsc;
+	size_t per_bank, nbank = 0, i, j;
+	struct dt_range banks[HANDOFF_MAX_BANKS];
+	fdt32_t reg[HANDOFF_MAX_BANKS * 4];
+	uint64_t ob, oe, rb, re, pb, pe;
+
+	rc = dt_validate(runtime, runtime_size);
+	if (rc < 0)
+		return rc;
+	rc = dt_validate(payload, payload_size);
+	if (rc < 0)
+		return rc;
+
+	if (output == NULL)
+		return -FDT_ERR_BADVALUE;
+	if (((uintptr_t)output & 7u) != 0)
+		return -FDT_ERR_BADVALUE;
+	if (capacity < sizeof(struct fdt_header))
+		return -FDT_ERR_NOSPACE;
+	if (capacity > HANDOFF_MAX_CAP || capacity > (size_t)INT_MAX)
+		return -FDT_ERR_BADVALUE;
+
+	ob = (uint64_t)(uintptr_t)output;
+	oe = ob + (uint64_t)capacity;
+	if (oe < ob)
+		return -FDT_ERR_BADVALUE;
+	rb = (uint64_t)(uintptr_t)runtime;
+	re = rb + (uint64_t)runtime_size;
+	if (re < rb || dt_ovl(ob, oe, rb, re))
+		return -FDT_ERR_BADVALUE;
+	pb = (uint64_t)(uintptr_t)payload;
+	pe = pb + (uint64_t)payload_size;
+	if (pe < pb || dt_ovl(ob, oe, pb, pe))
+		return -FDT_ERR_BADVALUE;
+
+	/* source root address/size cells */
+	root = fdt_path_offset(runtime, "/");
+	if (root < 0)
+		return root;
+	rc = dt_u32(runtime, root, "#address-cells", &sac);
+	if (rc < 0)
+		return rc;
+	rc = dt_u32(runtime, root, "#size-cells", &ssc);
+	if (rc < 0)
+		return rc;
+	if ((sac != 1 && sac != 2) || (ssc != 1 && ssc != 2))
+		return -FDT_ERR_BADVALUE;
+
+	/* target root must be 2/2 */
+	{
+		int proot = fdt_path_offset(payload, "/");
+		if (proot < 0)
+			return proot;
+		rc = dt_u32(payload, proot, "#address-cells", &tac);
+		if (rc < 0)
+			return rc;
+		rc = dt_u32(payload, proot, "#size-cells", &tsc);
+		if (rc < 0)
+			return rc;
+		if (tac != 2 || tsc != 2)
+			return -FDT_ERR_BADVALUE;
+	}
+
+	per_bank = 4u * ((size_t)sac + (size_t)ssc);
+
+	/* collect enabled memory banks in traversal order */
+	for (node = fdt_first_subnode(runtime, root); node >= 0;
+	     node = fdt_next_subnode(runtime, node)) {
+		const char *dtype = dt_string(runtime, node, "device_type");
+		const void *prop;
+		int plen;
+		if (dtype == NULL || strcmp(dtype, "memory") != 0)
+			continue;
+		if (!dt_available(runtime, node))
+			continue;
+		prop = fdt_getprop(runtime, node, "reg", &plen);
+		if (prop == NULL || plen <= 0)
+			return -FDT_ERR_BADVALUE;
+		if ((size_t)plen % per_bank != 0)
+			return -FDT_ERR_BADVALUE;
+		for (i = 0; i < (size_t)plen / per_bank; i++) {
+			uint64_t base, sz, bend;
+			rc = dt_raw_reg(runtime, node, (int)i, &base, &sz);
+			if (rc < 0)
+				return rc;
+			if (sz == 0)
+				return -FDT_ERR_BADVALUE;
+			if (base > UINT64_MAX - sz)
+				return -FDT_ERR_BADVALUE;
+			bend = base + sz;
+			for (j = 0; j < nbank; j++) {
+				uint64_t bj = banks[j].base;
+				uint64_t ej = banks[j].base + banks[j].size;
+				if (dt_ovl(base, bend, bj, ej))
+					return -FDT_ERR_BADVALUE;
+			}
+			if (nbank >= HANDOFF_MAX_BANKS)
+				return -FDT_ERR_NOSPACE;
+			banks[nbank].base = base;
+			banks[nbank].size = sz;
+			nbank++;
+		}
+	}
+	if (nbank == 0)
+		return -FDT_ERR_NOTFOUND;
+
+	for (i = 0; i < nbank; i++) {
+		reg[i * 4 + 0] = cpu_to_fdt32((uint32_t)(banks[i].base >> 32));
+		reg[i * 4 + 1] = cpu_to_fdt32((uint32_t)(banks[i].base & 0xffffffffu));
+		reg[i * 4 + 2] = cpu_to_fdt32((uint32_t)(banks[i].size >> 32));
+		reg[i * 4 + 3] = cpu_to_fdt32((uint32_t)(banks[i].size & 0xffffffffu));
+	}
+
+	rc = fdt_open_into(payload, output, (int)capacity);
+	if (rc < 0)
+		return rc;
+
+	/* remove every root child with device_type == memory */
+	for (;;) {
+		int found = 0;
+		root = fdt_path_offset(output, "/");
+		if (root < 0)
+			return root;
+		for (child = fdt_first_subnode(output, root); child >= 0;
+		     child = fdt_next_subnode(output, child)) {
+			const char *dtype = dt_string(output, child, "device_type");
+			if (dtype != NULL && strcmp(dtype, "memory") == 0) {
+				rc = fdt_del_node(output, child);
+				if (rc < 0)
+					return rc;
+				found = 1;
+				break;
+			}
+		}
+		if (!found)
+			break;
+	}
+
+	root = fdt_path_offset(output, "/");
+	if (root < 0)
+		return root;
+	rc = fdt_add_subnode(output, root, "memory");
+	if (rc < 0)
+		return rc;
+	node = rc;
+	rc = fdt_setprop_string(output, node, "device_type", "memory");
+	if (rc < 0)
+		return rc;
+	rc = fdt_setprop(output, node, "reg", reg,
+			 (int)(nbank * 4 * sizeof(fdt32_t)));
+	if (rc < 0)
+		return rc;
+
+	/* drop stale chosen initrd bounds (ignore missing props only) */
+	{
+		int chosen = fdt_path_offset(output, "/chosen");
+		if (chosen >= 0) {
+			rc = fdt_delprop(output, chosen, "linux,initrd-start");
+			if (rc < 0 && rc != -FDT_ERR_NOTFOUND)
+				return rc;
+			chosen = fdt_path_offset(output, "/chosen");
+			if (chosen < 0)
+				return chosen;
+			rc = fdt_delprop(output, chosen, "linux,initrd-end");
+			if (rc < 0 && rc != -FDT_ERR_NOTFOUND)
+				return rc;
+		}
+	}
+
+	rc = dt_handoff_reservations(runtime, output);
+	if (rc < 0)
+		return rc;
+	rc = fdt_pack(output);
+	if (rc < 0)
+		return rc;
+
+	rc = dt_validate(output, capacity);
+	if (rc < 0)
+		return rc;
+
+	return 0;
+}
diff --git a/src/dt/handoff_reservations.c b/src/dt/handoff_reservations.c
new file mode 100644
index 0000000..9004c88
--- /dev/null
+++ b/src/dt/handoff_reservations.c
@@ -0,0 +1,242 @@
+#include "dt.h"
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+
+#define SRC_CAP 128
+#define DST_CAP 256
+
+struct item {
+    uint64_t base, size;
+    bool nomap, reusable;
+};
+
+static int collect(const void *f, struct item *arr, size_t cap, size_t *count)
+{
+    size_t n = 0;
+    int nrsv = fdt_num_mem_rsv(f);
+    if (nrsv < 0)
+        return nrsv;
+    for (int i = 0; i < nrsv; i++) {
+        uint64_t a, s;
+        int r = fdt_get_mem_rsv(f, i, &a, &s);
+        if (r)
+            return r;
+        if (s == 0 || a + s < a)
+            return -FDT_ERR_BADVALUE;
+        if (n >= cap)
+            return -FDT_ERR_NOSPACE;
+        arr[n].base = a; arr[n].size = s;
+        arr[n].nomap = false; arr[n].reusable = false;
+        n++;
+    }
+
+    int root = fdt_path_offset(f, "/");
+    if (root < 0)
+        return root;
+    int rm = fdt_subnode_offset(f, root, "reserved-memory");
+    if (rm == -FDT_ERR_NOTFOUND) {
+        *count = n;
+        return 0;
+    }
+    if (rm < 0)
+        return rm;
+    if (!dt_available(f, rm)) {
+        *count = n;
+        return 0;
+    }
+
+    uint32_t ac, sc, rac, rsc;
+    int r = dt_u32(f, root, "#address-cells", &ac);
+    if (r)
+        return r;
+    r = dt_u32(f, root, "#size-cells", &sc);
+    if (r)
+        return r;
+    r = dt_u32(f, rm, "#address-cells", &rac);
+    if (r)
+        return r;
+    r = dt_u32(f, rm, "#size-cells", &rsc);
+    if (r)
+        return r;
+    if ((rac != 1 && rac != 2) || (rsc != 1 && rsc != 2))
+        return -FDT_ERR_BADVALUE;
+    if (rac != ac || rsc != sc)
+        return -FDT_ERR_BADVALUE;
+
+    int rl;
+    const void *rg = fdt_getprop(f, rm, "ranges", &rl);
+    if (!rg)
+        return rl;
+    if (rl != 0)
+        return -FDT_ERR_BADVALUE;
+
+    int cells = (int)(4 * (rac + rsc));
+    for (int ch = fdt_first_subnode(f, rm); ch >= 0;
+         ch = fdt_next_subnode(f, ch)) {
+        if (!dt_available(f, ch))
+            continue;
+        int len;
+        const void *reg = fdt_getprop(f, ch, "reg", &len);
+        if (!reg) {
+            if (len == -FDT_ERR_NOTFOUND)
+                continue;
+            return len;
+        }
+        if (len <= 0 || len % cells)
+            return -FDT_ERR_BADVALUE;
+        bool nomap = false, reusable = false;
+        r = dt_bool(f, ch, "no-map", &nomap);
+        if (r)
+            return r;
+        r = dt_bool(f, ch, "reusable", &reusable);
+        if (r)
+            return r;
+        if (nomap && reusable)
+            return -FDT_ERR_BADVALUE;
+        int nent = len / cells;
+        for (int k = 0; k < nent; k++) {
+            uint64_t b, s;
+            r = dt_raw_reg(f, ch, (unsigned)k, &b, &s);
+            if (r)
+                return r;
+            if (s == 0)
+                continue;
+            if (b + s < b)
+                return -FDT_ERR_BADVALUE;
+            if (n >= cap)
+                return -FDT_ERR_NOSPACE;
+            arr[n].base = b; arr[n].size = s;
+            arr[n].nomap = nomap; arr[n].reusable = reusable;
+            n++;
+        }
+    }
+    *count = n;
+    return 0;
+}
+
+static int append_gap(void *out, struct item *arr, size_t *count,
+                      uint64_t base, uint64_t size, bool nomap)
+{
+    if (*count >= DST_CAP)
+        return -FDT_ERR_NOSPACE;
+    if (size == 0 || base + size < base)
+        return -FDT_ERR_BADVALUE;
+
+    if (!nomap) {
+        int r = fdt_add_mem_rsv(out, base, size);
+        if (r)
+            return r;
+    } else {
+        int root = fdt_path_offset(out, "/");
+        if (root < 0)
+            return root;
+        int rm = fdt_subnode_offset(out, root, "reserved-memory");
+        if (rm == -FDT_ERR_NOTFOUND) {
+            rm = fdt_add_subnode(out, root, "reserved-memory");
+            if (rm < 0)
+                return rm;
+            int r = fdt_setprop_u32(out, rm, "#address-cells", 2);
+            if (r)
+                return r;
+            r = fdt_setprop_u32(out, rm, "#size-cells", 2);
+            if (r)
+                return r;
+            r = fdt_setprop_empty(out, rm, "ranges");
+            if (r)
+                return r;
+        } else {
+            if (rm < 0)
+                return rm;
+            if (!dt_available(out, rm))
+                return -FDT_ERR_BADSTATE;
+            uint32_t c;
+            int r = dt_u32(out, rm, "#address-cells", &c);
+            if (r || c != 2)
+                return r ? r : -FDT_ERR_BADVALUE;
+            r = dt_u32(out, rm, "#size-cells", &c);
+            if (r || c != 2)
+                return r ? r : -FDT_ERR_BADVALUE;
+            int rl;
+            const void *rg = fdt_getprop(out, rm, "ranges", &rl);
+            if (!rg)
+                return rl;
+            if (rl != 0)
+                return -FDT_ERR_BADVALUE;
+        }
+        char name[64];
+        snprintf(name, sizeof name, "kshim-firmware@%llx",
+                 (unsigned long long)base);
+        int ch = fdt_add_subnode(out, rm, name);
+        if (ch < 0)
+            return ch;
+        fdt64_t reg[2];
+        reg[0] = cpu_to_fdt64(base);
+        reg[1] = cpu_to_fdt64(size);
+        int r = fdt_setprop(out, ch, "reg", reg, sizeof reg);
+        if (r)
+            return r;
+        r = fdt_setprop_empty(out, ch, "no-map");
+        if (r)
+            return r;
+    }
+
+    arr[*count].base = base;
+    arr[*count].size = size;
+    arr[*count].nomap = nomap;
+    arr[*count].reusable = false;
+    (*count)++;
+    return 0;
+}
+
+int dt_handoff_reservations(const void *runtime, void *output)
+{
+    struct item src[SRC_CAP], dst[DST_CAP];
+    size_t nsrc = 0, ndst = 0;
+    int r = collect(runtime, src, SRC_CAP, &nsrc);
+    if (r)
+        return r;
+    r = collect(output, dst, DST_CAP, &ndst);
+    if (r)
+        return r;
+
+    for (int pass = 0; pass < 2; pass++) {
+        bool want = (pass == 0);
+        for (size_t i = 0; i < nsrc; i++) {
+            if (src[i].nomap != want)
+                continue;
+            uint64_t cursor = src[i].base;
+            uint64_t end = src[i].base + src[i].size;
+            while (cursor < end) {
+                uint64_t cover_end = cursor;
+                uint64_t next_start = end;
+                for (size_t j = 0; j < ndst; j++) {
+                    uint64_t db = dst[j].base;
+                    uint64_t de = dst[j].base + dst[j].size;
+                    if (de <= cursor || db >= end)
+                        continue;
+                    if (dst[j].reusable ||
+                        (src[i].nomap && !dst[j].nomap))
+                        return -FDT_ERR_BADVALUE;
+                    if (db <= cursor) {
+                        if (de > cover_end)
+                            cover_end = de;
+                    } else if (db < next_start) {
+                        next_start = db;
+                    }
+                }
+                if (cover_end > cursor) {
+                    cursor = cover_end < end ? cover_end : end;
+                    continue;
+                }
+                r = append_gap(output, dst, &ndst, cursor,
+                               next_start - cursor, src[i].nomap);
+                if (r)
+                    return r;
+                cursor = next_start;
+            }
+        }
+    }
+    return 0;
+}
diff --git a/src/include/dt_handoff.h b/src/include/dt_handoff.h
new file mode 100644
index 0000000..90ab3d8
--- /dev/null
+++ b/src/include/dt_handoff.h
@@ -0,0 +1,24 @@
+#ifndef DT_HANDOFF_H
+#define DT_HANDOFF_H
+
+#include <stddef.h>
+
+/*
+ * Merge a runtime (source) device tree's RAM/memory description into a
+ * payload (target) device tree, producing a merged output FDT.
+ *
+ * runtime / payload inputs are immutable: the call MUST NOT modify them.
+ * output buffer contents are invalid on failure (do not use on non-zero rc).
+ *
+ * Destination requires root "#address-cells = 2" and "#size-cells = 2".
+ * The initial builtin-initramfs profile removes destination
+ * linux,initrd-start / linux,initrd-end properties.
+ * Any caller opt-in policy is applied externally, not by this function.
+ *
+ * Returns 0 on success, a negative FDT error code on failure.
+ */
+int dt_handoff_memory(const void *runtime, size_t runtime_size,
+                      const void *payload, size_t payload_size,
+                      void *output, size_t capacity);
+
+#endif /* DT_HANDOFF_H */
