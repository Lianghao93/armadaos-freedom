diff --git a/tests/dt_handoff_reservations_test.c b/tests/dt_handoff_reservations_test.c
new file mode 100644
index 0000000..8205f7b
--- /dev/null
+++ b/tests/dt_handoff_reservations_test.c
@@ -0,0 +1,162 @@
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "dt.h"
+#include "dt_handoff.h"
+
+
+static uint64_t rt[8192], pl[8192], out[8192];
+
+static void init(void *f)
+{
+    assert(fdt_create_empty_tree(f, sizeof(rt)) == 0);
+    assert(fdt_setprop_u32(f, 0, "#address-cells", 2) == 0);
+    assert(fdt_setprop_u32(f, 0, "#size-cells", 2) == 0);
+}
+
+static void reg(void *f, int node, uint64_t base, uint64_t size)
+{
+    fdt64_t cells[2] = { cpu_to_fdt64(base), cpu_to_fdt64(size) };
+    assert(fdt_setprop(f, node, "reg", cells, sizeof(cells)) == 0);
+}
+
+static int reserve(void *f, const char *name, uint64_t base, uint64_t size, int nomap)
+{
+    int p = fdt_subnode_offset(f, 0, "reserved-memory");
+    if (p < 0) {
+        p = fdt_add_subnode(f, 0, "reserved-memory");
+        assert(p >= 0);
+        assert(fdt_setprop_u32(f, p, "#address-cells", 2) == 0);
+        assert(fdt_setprop_u32(f, p, "#size-cells", 2) == 0);
+        assert(fdt_setprop(f, p, "ranges", NULL, 0) == 0);
+    }
+    p = fdt_subnode_offset(f, 0, "reserved-memory");
+    assert(p >= 0);
+    int node = fdt_add_subnode(f, p, name);
+    assert(node >= 0);
+    reg(f, node, base, size);
+    if (nomap)
+        assert(fdt_setprop(f, node, "no-map", NULL, 0) == 0);
+    return node;
+}
+
+static void setup(void)
+{
+    init(rt);
+    init(pl);
+    int m = fdt_add_subnode(rt, 0, "memory");
+    assert(m >= 0);
+    assert(fdt_setprop_string(rt, m, "device_type", "memory") == 0);
+    reg(rt, m, 0x80000000, 0x40000000);
+}
+
+static void test1(void)
+{
+    setup();
+    int src = reserve(rt, "src", 0x90000000, 0x4000, 1);
+    assert(fdt_setprop_u32(rt, src, "phandle", 77) == 0);
+    reserve(rt, "zeros", 0, 0, 1);
+    int rm = fdt_subnode_offset(rt, 0, "reserved-memory");
+    int sz = fdt_add_subnode(rt, rm, "sizeonly");
+    assert(sz >= 0);
+    assert(fdt_setprop_u64(rt, sz, "size", 0x1000) == 0);
+    int d = reserve(rt, "disabled", 0x92000000, 0x1000, 1);
+    assert(fdt_setprop_string(rt, d, "status", "disabled") == 0);
+    assert(fdt_add_mem_rsv(rt, 0x91000000, 0x1000) == 0);
+    int ex = reserve(pl, "existing", 0x90001000, 0x1000, 1);
+    assert(fdt_setprop_u32(pl, ex, "phandle", 9) == 0);
+    assert(fdt_setprop_string(pl, ex, "compatible", "test") == 0);
+
+    struct dt_range ranges[16];
+    bool nomap[16];
+    size_t n = 0;
+    assert(dt_handoff_memory(rt, sizeof(rt), pl, sizeof(pl), out, sizeof(out)) == 0);
+    assert(dt_reservations(out, ranges, nomap, 16, &n) == 0);
+    assert(n == 4);
+
+    bool m0 = false, m1 = false, m2 = false, m3 = false;
+    for (size_t i = 0; i < n; i++) {
+        if (ranges[i].base == 0x90001000 && ranges[i].size == 0x1000) m0 = true;
+        if (ranges[i].base == 0x90000000 && ranges[i].size == 0x1000) m1 = true;
+        if (ranges[i].base == 0x90002000 && ranges[i].size == 0x2000) m2 = true;
+        if (ranges[i].base == 0x91000000 && ranges[i].size == 0x1000) m3 = true;
+        if (ranges[i].base == 0x90000000 || ranges[i].base == 0x90002000)
+            assert(nomap[i] == true);
+    }
+    assert(m0 && m1 && m2 && m3);
+
+    assert(fdt_num_mem_rsv(out) == 1);
+    uint64_t a = 0, s = 0;
+    assert(fdt_get_mem_rsv(out, 0, &a, &s) == 0);
+    assert(a == 0x91000000 && s == 0x1000);
+    int n9 = fdt_node_offset_by_phandle(out, 9);
+    assert(n9 >= 0);
+    const char *c = fdt_getprop(out, n9, "compatible", NULL);
+    assert(c != NULL && strcmp(c, "test") == 0);
+    assert(fdt_node_offset_by_phandle(out, 77) < 0);
+}
+
+static void test2(void)
+{
+    setup();
+    reserve(rt, "src", 0x90000000, 0x4000, 1);
+    reserve(pl, "tgt", 0x90001000, 0x1000, 0);
+    assert(dt_handoff_memory(rt, sizeof(rt), pl, sizeof(pl), out, sizeof(out)) < 0);
+}
+
+static void test3(void)
+{
+    setup();
+    int src = reserve(rt, "src", 0x91000000, 0x1000, 0);
+    assert(fdt_setprop_string(rt, src, "compatible", "src") == 0);
+    assert(fdt_setprop_u32(rt, src, "phandle", 55) == 0);
+    assert(dt_handoff_memory(rt, sizeof(rt), pl, sizeof(pl), out, sizeof(out)) == 0);
+    assert(fdt_num_mem_rsv(out) == 1);
+    uint64_t a = 0, s = 0;
+    assert(fdt_get_mem_rsv(out, 0, &a, &s) == 0);
+    assert(a == 0x91000000 && s == 0x1000);
+    assert(fdt_node_offset_by_phandle(out, 55) < 0);
+    for (int off = -1; (off = fdt_next_node(out, off, NULL)) >= 0; ) {
+        const char *cp = fdt_getprop(out, off, "compatible", NULL);
+        assert(cp == NULL || strcmp(cp, "src") != 0);
+    }
+    int rm = fdt_subnode_offset(out, 0, "reserved-memory");
+    if (rm >= 0) {
+        for (int ch = fdt_first_subnode(out, rm); ch >= 0; ch = fdt_next_subnode(out, ch))
+            assert(fdt_getprop(out, ch, "no-map", NULL) == NULL);
+    }
+}
+
+static void test4(void)
+{
+    setup();
+    assert(fdt_setprop_u32(rt, 0, "#address-cells", 1) == 0);
+    assert(fdt_setprop_u32(rt, 0, "#size-cells", 1) == 0);
+    int m = fdt_path_offset(rt, "/memory");
+    assert(m >= 0);
+    fdt32_t cells[2] = { cpu_to_fdt32(0x40000000), cpu_to_fdt32(0x10000000) };
+    assert(fdt_setprop(rt, m, "reg", cells, sizeof(cells)) == 0);
+    assert(dt_handoff_memory(rt, sizeof(rt), pl, sizeof(pl), out, sizeof(out)) == 0);
+    int mo = fdt_path_offset(out, "/memory");
+    assert(mo >= 0);
+    int len = 0;
+    assert(fdt_getprop(out, mo, "reg", &len) != NULL && len == 16);
+    uint64_t a = 0, s = 0;
+    assert(dt_raw_reg(out, mo, 0, &a, &s) == 0);
+    assert(a == 0x40000000 && s == 0x10000000);
+    const fdt32_t *ac = fdt_getprop(out, 0, "#address-cells", NULL);
+    const fdt32_t *sc = fdt_getprop(out, 0, "#size-cells", NULL);
+    assert(ac != NULL && fdt32_to_cpu(*ac) == 2);
+    assert(sc != NULL && fdt32_to_cpu(*sc) == 2);
+}
+
+int main(void)
+{
+    test1();
+    test2();
+    test3();
+    test4();
+    printf("dt_handoff_reservations_test PASS\n");
+    return 0;
+}
diff --git a/tests/dt_handoff_test.c b/tests/dt_handoff_test.c
new file mode 100644
index 0000000..5fe8813
--- /dev/null
+++ b/tests/dt_handoff_test.c
@@ -0,0 +1,148 @@
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+#include <dt.h>
+#include <dt_handoff.h>
+
+static uint64_t g_out[2048];
+
+static void expect_neg(void *rt, size_t rtsz, void *pl, size_t plsz, size_t cap)
+{
+	static uint64_t srt[2048], spl[2048];
+	memcpy(srt, rt, rtsz);
+	memcpy(spl, pl, plsz);
+	int r = dt_handoff_memory(rt, rtsz, pl, plsz, g_out, cap);
+	assert(r < 0);
+	assert(memcmp(srt, rt, rtsz) == 0);
+	assert(memcmp(spl, pl, plsz) == 0);
+}
+
+int main(void)
+{
+	static uint64_t rt[2048], pl[2048], out[2048], snaprt[2048], snappl[2048];
+	fdt32_t reg8[8] = {
+		cpu_to_fdt32(0), cpu_to_fdt32(0x80000000u),
+		cpu_to_fdt32(0), cpu_to_fdt32(0x40000000u),
+		cpu_to_fdt32(1), cpu_to_fdt32(0),
+		cpu_to_fdt32(0), cpu_to_fdt32(0x40000000u)
+	};
+	fdt32_t reg16[4] = {0, 0, 0, 0};
+	int off, ch, n, len;
+
+	/* runtime tree: one /memory node, two banks */
+	assert(fdt_create_empty_tree(rt, sizeof rt) == 0);
+	assert(fdt_setprop_u32(rt, 0, "#address-cells", 2) == 0);
+	assert(fdt_setprop_u32(rt, 0, "#size-cells", 2) == 0);
+	off = fdt_add_subnode(rt, 0, "memory");
+	assert(off >= 0);
+	assert(fdt_setprop_string(rt, off, "device_type", "memory") == 0);
+	assert(fdt_setprop(rt, off, "reg", reg8, sizeof reg8) == 0);
+	off = fdt_add_subnode(rt, 0, "chosen");
+	assert(off >= 0);
+	assert(fdt_setprop_string(rt, off, "bootargs", "android-only") == 0);
+
+	/* payload tree */
+	assert(fdt_create_empty_tree(pl, sizeof pl) == 0);
+	assert(fdt_setprop_u32(pl, 0, "#address-cells", 2) == 0);
+	assert(fdt_setprop_u32(pl, 0, "#size-cells", 2) == 0);
+	assert(fdt_setprop_string(pl, 0, "model", "payload-model") == 0);
+	off = fdt_add_subnode(pl, 0, "memory");
+	assert(off >= 0);
+	assert(fdt_setprop_string(pl, off, "device_type", "memory") == 0);
+	assert(fdt_setprop(pl, off, "reg", reg16, sizeof reg16) == 0);
+	off = fdt_add_subnode(pl, 0, "memory@a0000000");
+	assert(off >= 0);
+	assert(fdt_setprop_string(pl, off, "device_type", "memory") == 0);
+	assert(fdt_setprop(pl, off, "reg", reg16, sizeof reg16) == 0);
+	ch = fdt_add_subnode(pl, 0, "chosen");
+	assert(ch >= 0);
+	assert(fdt_setprop_string(pl, ch, "bootargs", "linux-only") == 0);
+	assert(fdt_setprop_string(pl, ch, "stdout-path", "serial0") == 0);
+	assert(fdt_setprop_u32(pl, ch, "linux,initrd-start", 0) == 0);
+	assert(fdt_setprop_u32(pl, ch, "linux,initrd-end", 0) == 0);
+
+	/* positive case */
+	memcpy(snaprt, rt, sizeof rt);
+	memcpy(snappl, pl, sizeof pl);
+	assert(dt_handoff_memory(rt, sizeof rt, pl, sizeof pl, out, sizeof out) == 0);
+	assert(!dt_validate(out, sizeof out));
+	assert(memcmp(snaprt, rt, sizeof rt) == 0);
+	assert(memcmp(snappl, pl, sizeof pl) == 0);
+
+	n = 0;
+	fdt_for_each_subnode(off, out, 0) {
+		const fdt32_t *rg;
+		const char *dtv = fdt_getprop(out, off, "device_type", NULL);
+		if (dtv && !strcmp(dtv, "memory")) {
+			n++;
+			rg = fdt_getprop(out, off, "reg", &len);
+			assert(rg && len == (int)sizeof reg8);
+			assert(memcmp(rg, reg8, sizeof reg8) == 0);
+		}
+	}
+	assert(n == 1);
+
+	assert(!strcmp(fdt_getprop(out, 0, "model", NULL), "payload-model"));
+	ch = fdt_path_offset(out, "/chosen");
+	assert(ch >= 0);
+	assert(!strcmp(fdt_getprop(out, ch, "bootargs", NULL), "linux-only"));
+	assert(!strcmp(fdt_getprop(out, ch, "stdout-path", NULL), "serial0"));
+	assert(fdt_getprop(out, ch, "linux,initrd-start", &len) == NULL && len == -FDT_ERR_NOTFOUND);
+	assert(fdt_getprop(out, ch, "linux,initrd-end", &len) == NULL && len == -FDT_ERR_NOTFOUND);
+
+	/* negative: unsupported destination capacity */
+	expect_neg(rt, sizeof rt, pl, sizeof pl, 64);
+
+	/* negative: all-zero RAM reg */
+	{
+		fdt32_t zc[4] = {0, 0, 0, 0};
+		off = fdt_path_offset(rt, "/memory");
+		assert(off >= 0);
+		assert(fdt_setprop(rt, off, "reg", zc, sizeof zc) == 0);
+	}
+	expect_neg(rt, sizeof rt, pl, sizeof pl, sizeof g_out);
+	memcpy(rt, snaprt, sizeof rt);
+
+	/* negative: malformed (12-byte) RAM reg */
+	off = fdt_path_offset(rt, "/memory");
+	assert(off >= 0);
+	assert(fdt_setprop(rt, off, "reg", reg8, 12) == 0);
+	expect_neg(rt, sizeof rt, pl, sizeof pl, sizeof g_out);
+	memcpy(rt, snaprt, sizeof rt);
+
+	/* negative: RAM range overflow */
+	{
+		fdt32_t ovf[4] = {cpu_to_fdt32(0xffffffffu), cpu_to_fdt32(0xfffff000u),
+			cpu_to_fdt32(0), cpu_to_fdt32(0x2000u)};
+		off = fdt_path_offset(rt, "/memory");
+		assert(off >= 0);
+		assert(fdt_setprop(rt, off, "reg", ovf, sizeof ovf) == 0);
+	}
+	expect_neg(rt, sizeof rt, pl, sizeof pl, sizeof g_out);
+	memcpy(rt, snaprt, sizeof rt);
+
+	/* negative: overlapping banks */
+	{
+		fdt32_t ob[8];
+		memcpy(ob, reg8, sizeof ob);
+		ob[4] = cpu_to_fdt32(0);
+		ob[5] = cpu_to_fdt32(0x90000000u);
+		ob[6] = cpu_to_fdt32(0);
+		ob[7] = cpu_to_fdt32(0x40000000u);
+		off = fdt_path_offset(rt, "/memory");
+		assert(off >= 0);
+		assert(fdt_setprop(rt, off, "reg", ob, sizeof ob) == 0);
+	}
+	expect_neg(rt, sizeof rt, pl, sizeof pl, sizeof g_out);
+	memcpy(rt, snaprt, sizeof rt);
+
+	/* negative: unsupported root 1/1 */
+	assert(fdt_setprop_u32(pl, 0, "#address-cells", 1) == 0);
+	assert(fdt_setprop_u32(pl, 0, "#size-cells", 1) == 0);
+	expect_neg(rt, sizeof rt, pl, sizeof pl, sizeof g_out);
+	memcpy(rt, snaprt, sizeof rt);
+
+	printf("dt_handoff_test PASS\n");
+	return 0;
+}
diff --git a/tests/linux_handoff_qemu.py b/tests/linux_handoff_qemu.py
new file mode 100644
index 0000000..e3085d1
--- /dev/null
+++ b/tests/linux_handoff_qemu.py
@@ -0,0 +1,170 @@
+#!/usr/bin/env python3
+"""QEMU-only Linux/embedded init handoff validation for the TB323FU kShim.
+
+Builds nothing. Drives an existing packer over a manifest_qemu.py A.bin
+fixture, boots the produced image under qemu-system-aarch64, and checks the
+kShim diagnostic handoff for two cases. No hardware, no publish, no cleanup.
+"""
+import argparse
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+
+def run(cmd, log=None, timeout=None, check=False, cwd=None):
+    cmd = [str(c) for c in cmd]
+    print("+", " ".join(cmd), flush=True)
+    try:
+        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                           timeout=timeout, cwd=cwd)
+    except subprocess.TimeoutExpired as e:
+        if log:
+            Path(log).write_bytes(e.stdout or b"")
+        raise
+    data = p.stdout or b""
+    if log:
+        Path(log).write_bytes(data)
+    if check and p.returncode != 0:
+        raise SystemExit("command failed (%d): %s" % (p.returncode, " ".join(cmd)))
+    return p.returncode, data
+
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser(description="QEMU Linux handoff validation")
+    ap.add_argument("--runtime", required=True, type=Path)
+    ap.add_argument("--kernel", required=True, type=Path)
+    ap.add_argument("--packer", required=True, type=Path)
+    ap.add_argument("--base", required=True, type=Path)
+    ap.add_argument("--out", required=True, type=Path)
+    args = ap.parse_args()
+
+    runtime = args.runtime.resolve()
+    kernel = args.kernel.resolve()
+    packer = args.packer.resolve()
+    base = args.base.resolve()
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+
+    for p in (runtime, kernel, packer, base):
+        if not p.is_file():
+            raise SystemExit("missing input: %s" % p)
+    if runtime.stat().st_size != 4 * 1024 * 1024:
+        raise SystemExit("runtime must be exactly 4 MiB")
+
+    dtb = out / "qemu.dtb"
+    run(["qemu-system-aarch64", "-machine", "virt,gic-version=3,dumpdtb=" + str(dtb),
+         "-cpu", "cortex-a76", "-smp", "1",
+         "-m", "1024M", "-display", "none", "-monitor", "none",
+         "-serial", "none"],
+        log=out / "qemu-dumpdtb.log", timeout=30, check=True)
+
+    _rc, reg = run(["fdtget", "-t", "x", str(dtb), "/memory@40000000", "reg"])
+    if reg.decode().strip() != "0 40000000 0 40000000":
+        raise SystemExit("unexpected QEMU root RAM node: %r" % reg.decode().strip())
+
+    kernel_sha = sha256(kernel)
+    runtime_sha = sha256(runtime)
+    results = {}
+    failed = False
+
+    for case in ("inherit-ram", "reject-bad-target"):
+        dt = out / (case + ".dtb")
+        shutil.copyfile(dtb, dt)
+        run(["fdtput", "-t", "s", str(dt), "/chosen", "bootargs",
+             "console=ttyAMA0 earlycon rdinit=/init "
+             "kshim.diag_poweroff=1 loglevel=5"], check=True)
+        run(["fdtput", str(dt), "/chosen", "kshim,inherit-runtime-memory"], check=True)
+        run(["fdtput", "-t", "x", str(dt), "/memory@40000000", "reg",
+             "0", "0", "0", "0"], check=True)
+        run(["fdtput", "-t", "x", str(dt), "/chosen", "linux,initrd-start",
+             "dead0000"], check=True)
+        run(["fdtput", "-t", "x", str(dt), "/chosen", "linux,initrd-end",
+             "dead1000"], check=True)
+        if case == "reject-bad-target":
+            run(["fdtput", "-t", "x", str(dt), "/", "#address-cells", "1"], check=True)
+
+        cfg = out / (case + ".cfg")
+        cfg.write_text("\n".join([
+            "[Pack]",
+            "Shim=" + str(runtime),
+            "Output=" + case + ".bin",
+            "Default=Image-Linux",
+            "Timeout=1",
+            "[Image-Base]",
+            "Name=Fallback",
+            "Path=" + str(base),
+            "Type=Linux",
+            "BaseImage=true",
+            "[Image-Linux]",
+            "Name=Linux diagnostic",
+            "Path=" + str(kernel),
+            "Type=Linux",
+            "BaseImage=false",
+            "Align=21",
+            "DeviceTreeBlob=Image-DTB",
+            "[Image-DTB]",
+            "Name=Linux DT",
+            "Path=" + case + ".dtb",
+            "Type=DTB",
+            "BaseImage=false",
+            "[Manifest]",
+            "Type=Manifest",
+            "",
+        ]))
+
+        run([str(packer), str(cfg)], log=out / (case + "-pack.log"),
+            check=True, cwd=str(out))
+        image = out / (case + ".bin")
+        if not image.is_file():
+            raise SystemExit("packer did not produce %s" % image)
+
+        rc, data = run(["qemu-system-aarch64", "-machine", "virt,gic-version=3",
+            "-accel", "tcg", "-cpu", "cortex-a76", "-smp", "1", "-m", "1024M",
+            "-display", "none", "-monitor", "none", "-serial", "stdio",
+            "-no-reboot", "-kernel", str(image),
+            "-append", "console=ttyAMA0 rdinit=/wrong-source-init "
+                       "kshim.diag_poweroff=0"],
+            log=out / (case + ".log"), timeout=45)
+        text = data.decode("utf-8", "replace")
+
+        if case == "inherit-ram":
+            ok = (rc == 0
+                  and "TB323FU_DIAG_INIT_REACHED" in text
+                  and "KSHIM_DIAG_QEMU_PASS" in text
+                  and "rdinit=/init" in text
+                  and "/wrong-source-init" not in text)
+        else:
+            ok = (rc == 0
+                  and "PAYLOAD_A_PASS" in text
+                  and "KSHIM_DIAG_QEMU_PASS" not in text
+                  and "Memory handoff failed; booting base image" in text)
+
+        results[case] = {"status": "PASS" if ok else "FAIL", "returncode": rc}
+        print("PASS" if ok else "FAIL", case, flush=True)
+        if not ok:
+            failed = True
+
+    (out / "validation.json").write_text(json.dumps({
+        "cases": results,
+        "kernel_sha256": kernel_sha,
+        "runtime_sha256": runtime_sha,
+        "scope": "QEMU only; no TB323FU hardware validation",
+    }, indent=2) + "\n")
+
+    if failed:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
